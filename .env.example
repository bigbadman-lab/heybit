# Blank placeholders only. Do not put real values in this file.
# Local operator environment. Static credentials and infrastructure only.

ALCHEMY_SOLANA_RPC_URL=
ALCHEMY_SOLANA_WSS_URL=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BIT_DEPLOYER_KEYPAIR_PATH=

# Vercel public web configuration. Not a substitute for server credentials.
# The Next.js server also needs SUPABASE_SERVICE_ROLE_KEY from above. Do not prefix it for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Social bridge. Blank means do not publish. Leave blank until a separate publishing decision.
BIT_SOCIAL_PUBLISH_ENABLED=

# Reown AppKit project id for Human wallet join. Public in the browser by design.
# Read on the server from this name and passed into the client. Do not add a second id variable.
REOWN_PROJECT_ID=
